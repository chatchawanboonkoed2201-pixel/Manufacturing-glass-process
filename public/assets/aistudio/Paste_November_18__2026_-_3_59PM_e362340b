    /**
     * =========================================================================
     * 5. PARTICLE & PRODUCT ENTITY LOGIC
     * =========================================================================
     */
    function createWareItem(startX) {
      // Determine defects probabilistically based on current engineering state
      const hasBlister = Math.random() < simState.defectBreakdown.blister;
      const hasDeform = Math.random() < simState.defectBreakdown.deformed;
      const hasStressCrack = Math.random() < simState.defectBreakdown.stressCrack;

      let defectType = null;
      if (hasDeform) defectType = 'DEFORMED';
      else if (hasBlister) defectType = 'BLISTER';
      else if (hasStressCrack) defectType = 'CRACK';

      return {
        x: startX,
        y: 256,
        shape: simState.formingMode, // 'h28' | 'press' | 'is'
        defect: defectType,
        scanned: false,
        rejected: false,
        rejectY: 0,
        coatingLevel: 0, // 0 -> 1 (hot-end) -> 2 (cold-end)
      };
    }

    function updateEntities(dt) {
      const effectiveDt = dt * simState.speedMultiplier;
      simState.time += effectiveDt;

      // Recalculate metrics continuously when gas fluctuation fault is active
      if (simState.faults.gasPressure) {
        recalculateEngineeringMetrics();
      }

      // 1. Alternate Regenerative Burner Side every 3.5 seconds
      simState.burnerTimer += effectiveDt;
      if (simState.burnerTimer > 3.5) {
        simState.burnerTimer = 0;
        simState.burnerSide = simState.burnerSide === 'left' ? 'right' : 'left';
      }

      // 2. Furnace Refining Bubbles
      // Higher temperature -> faster bubble rise & escape; lower temp -> bubbles linger
      const riseFactor = Math.max(0.35, (simState.effectiveTemp - 1380) / 140);
      simState.bubbles.forEach(b => {
        b.y -= b.vy * riseFactor * effectiveDt;
        b.x += 5 * effectiveDt; // Gentle forward glass flow
        if (b.y < 216 || b.x > 415) {
          b.x = 285 + Math.random() * 120;
          b.y = 265 + Math.random() * 18;
        }
      });

      // 3. Gob Feeder Cutting Cadence
      // Map 20..80 cuts/min to visual spawn interval (1.6s down to 0.45s)
      const spawnInterval = 34 / simState.gobSpeed;
      simState.gobTimer += effectiveDt;
      if (simState.gobTimer >= spawnInterval) {
        simState.gobTimer = 0;
        simState.gobs.push({
          x: 505,
          y: 215,
          progress: 0, // 0 -> 1 (falls into Forming Machine)
        });
      }

      // Update falling Gobs
      for (let i = simState.gobs.length - 1; i >= 0; i--) {
        const g = simState.gobs[i];
        g.progress += effectiveDt * 2.2;
        if (g.progress >= 1) {
          simState.gobs.splice(i, 1);
          // Spawn newly formed glass product exiting Forming Machine
          simState.wareItems.push(createWareItem(685));
        }
      }

      // 4. Conveyor Belt Glassware Movement (Station 4 -> 5 -> 6 -> 7)
      const conveyorSpeed = 62 + (simState.gobSpeed - 20) * 0.45;
      for (let i = simState.wareItems.length - 1; i >= 0; i--) {
        const item = simState.wareItems[i];

        if (!item.rejected) {
          item.x += conveyorSpeed * effectiveDt;

          // Hot-End Coating zone (~1045)
          if (item.x > 1045 && item.coatingLevel < 1) item.coatingLevel = 1;
          // Cold-End Coating zone (~1125)
          if (item.x > 1125 && item.coatingLevel < 2) item.coatingLevel = 2;

          // Cold-End QC Laser Scanner (~1220)
          if (item.x >= 1220 && !item.scanned) {
            item.scanned = true;
            if (item.defect !== null) {
              item.rejected = true;
            }
          }

          // Reached Packaging Palletizer (~1345)
          if (item.x >= 1345) {
            simState.packedBoxes++;
            simState.wareItems.splice(i, 1);
          }
        } else {
          // Rejected item drops down into Cullet Crusher chute
          item.rejectY += 130 * effectiveDt;
          item.x += 12 * effectiveDt;
          if (item.rejectY >= 125) {
            simState.wareItems.splice(i, 1);
            // Spawn new crushed cullet particle into the return loop!
            simState.culletParticles.push({
              progress: 0,
              size: 3.5 + Math.random() * 2,
              color: '#38bdf8'
            });
          }
        }
      }

      // 5. Cullet Return Loop Particles (Station 7 Crusher -> Bottom Pipe -> Station 1 Cullet Silo)
      const culletLoopSpeed = 0.08 + (simState.culletRatio / 50) * 0.07;
      for (let i = simState.culletParticles.length - 1; i >= 0; i--) {
        const p = simState.culletParticles[i];
        p.progress += culletLoopSpeed * effectiveDt;
        if (p.progress >= 1) {
          if (simState.culletParticles.length > 22) {
            simState.culletParticles.splice(i, 1);
          } else {
            p.progress = 0;
          }
        }
      }
    }

    /**
     * =========================================================================
     * 6. MAIN PROCESS FLOW CANVAS RENDERING (ALL 7 STATIONS + CULLET LOOP)
     * =========================================================================
     */
    function renderProcessCanvas() {
      const dpr = processCanvas.width / rectWidthSafe(processCanvas);
      const scaleX = processCanvas.width / LOGICAL_W;
      const scaleY = processCanvas.height / LOGICAL_H;

      ctx.save();
      ctx.scale(scaleX, scaleY);
      ctx.clearRect(0, 0, LOGICAL_W, LOGICAL_H);

      // Draw Cullet Closed-Loop Return Pipe (Bottom Level y = 415)
      drawCulletReturnLoop();

      // Draw Main Hot-End / Cold-End Conveyor Line (y = 262)
      drawMainConveyor();

      // Draw All 7 Industrial Stations
      drawStation1_BatchHouse();
      drawStation2_FurnaceAndForehearth();
      drawStation3_GobFeeder();
      drawStation4_FormingMachine();
      drawStation5_AnnealingLehr();
      drawStation6_SurfaceCoating();
      drawStation7_QCAndPackaging();

      // Draw Moving Gobs & Glassware Items
      drawFallingGobs();
      drawWareItems();

      // Draw Station Bounding Boxes & Selection / Guided Tour Highlight
      drawStationOverlays();

      ctx.restore();
    }

    function rectWidthSafe(el) {
      return el.getBoundingClientRect().width || LOGICAL_W;
    }

    /**
     * Draw Closed-Loop Cullet Return Conveyor (Station 7 Crusher -> Station 1 Cullet Silo)
     */
    function drawCulletReturnLoop() {
      ctx.save();
      // Pipe path: (1235, 385) -> (1235, 422) -> (155, 422) -> (155, 115) -> (155, 115)
      ctx.strokeStyle = '#1e293b';
      ctx.lineWidth = 12;
      ctx.lineJoin = 'round';
      ctx.beginPath();
      ctx.moveTo(1235, 375);
      ctx.lineTo(1235, 422);
      ctx.lineTo(155, 422);
      ctx.lineTo(155, 115);
      ctx.stroke();

      // Inner cyan dashed flow line
      ctx.strokeStyle = 'rgba(6, 182, 212, 0.35)';
      ctx.lineWidth = 2;
      ctx.setLineDash([8, 8]);
      ctx.lineDashOffset = simState.time * 28;
      ctx.stroke();
      ctx.setLineDash([]);

      // Loop Label Badge
      ctx.fillStyle = '#0f172a';
      ctx.strokeStyle = '#0e7490';
      ctx.lineWidth = 1;
      roundRect(ctx, 560, 410, 290, 24, 6);
      ctx.fill();
      ctx.stroke();

      ctx.fillStyle = '#22d3ee';
      ctx.font = '600 11px "Noto Sans Thai", "JetBrains Mono", sans-serif';
      ctx.textAlign = 'center';
      ctx.fillText(`♻️ CULLET CLOSED-LOOP RECYCLING (${simState.culletRatio}% Cullet Mix)`, 705, 426);

      // Draw Crushed Cullet Particles along the path
      simState.culletParticles.forEach(p => {
        const pos = getCulletLoopCoords(p.progress);
        ctx.fillStyle = p.color;
        ctx.beginPath();
        ctx.arc(pos.x, pos.y, p.size, 0, Math.PI * 2);
        ctx.fill();
      });

      ctx.restore();
    }

    function getCulletLoopCoords(t) {
      // Total path length ~ 47 + 1080 + 307 = 1434
      const d1 = 47 / 1434;
      const d2 = (47 + 1080) / 1434;
      if (t < d1) {
        const local = t / d1;
        return { x: 1235, y: 375 + local * 47 };
      } else if (t < d2) {
        const local = (t - d1) / (d2 - d1);
        return { x: 1235 - local * 1080, y: 422 };
      } else {
        const local = (t - d2) / (1 - d2);
        return { x: 155, y: 422 - local * 307 };
      }
    }

