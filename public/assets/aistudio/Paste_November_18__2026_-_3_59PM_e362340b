<!DOCTYPE html>
<html lang="th" class="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>GlassLine 4.0 — Digital Twin & SCADA Simulator</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Inter, Noto Sans Thai, JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&family=Noto+Sans+Thai:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Noto Sans Thai"', 'Inter', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
          },
          colors: {
            scada: {
              bg: '#070b14',
              panel: '#0e1525',
              card: '#131c31',
              border: '#1f2d4a',
              accent: '#f97316',
              cyan: '#06b6d4',
            }
          }
        }
      }
    };
  </script>

  <style>
    /* Custom SCADA Industrial Styling & Scrollbars */
    body {
      background-color: #070b14;
      color: #e2e8f0;
      font-family: 'Noto Sans Thai', 'Inter', sans-serif;
      overflow-x: hidden;
    }

    /* Custom Range Sliders */
    input[type="range"].scada-slider {
      -webkit-appearance: none;
      appearance: none;
      height: 6px;
      border-radius: 999px;
      background: #1e293b;
      outline: none;
      cursor: pointer;
    }
    input[type="range"].scada-slider::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: #f97316;
      border: 2px solid #fff7ed;
      box-shadow: 0 0 10px rgba(249, 115, 22, 0.7);
      cursor: pointer;
      transition: transform 0.15s ease;
    }
    input[type="range"].scada-slider::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }
    input[type="range"].scada-slider.cyan-slider::-webkit-slider-thumb {
      background: #06b6d4;
      border-color: #ecfeff;
      box-shadow: 0 0 10px rgba(6, 182, 212, 0.7);
    }

    /* Subtle grid background for SCADA viewport */
    .scada-grid-bg {
      background-image: 
        linear-gradient(to right, rgba(30, 41, 59, 0.35) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(30, 41, 59, 0.35) 1px, transparent 1px);
      background-size: 28px 28px;
    }

    /* Blinking status LED */
    @keyframes pulse-led {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.35; }
    }
    .led-blink {
      animation: pulse-led 1.4s infinite ease-in-out;
    }

    /* Custom thin scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #0b1120;
    }
    ::-webkit-scrollbar-thumb {
      background: #283858;
      border-radius: 999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3b5280;
    }
  </style>
</head>
<body class="min-h-screen flex flex-col selection:bg-orange-500/30 selection:text-orange-200">

  <!-- =====================================================================
       TOP SCADA NAVIGATION & SYSTEM CONTROL BAR
       ===================================================================== -->
  <header class="sticky top-0 z-30 bg-[#0b1120]/95 backdrop-blur-md border-b border-slate-800 px-3 sm:px-6 py-2.5">
    <div class="max-w-[1600px] mx-auto flex flex-wrap items-center justify-between gap-3">
      <!-- Brand & Digital Twin Status -->
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-orange-500 via-amber-500 to-cyan-500 p-[1.5px] shadow-lg shadow-orange-500/20">
          <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center">
            <!-- Glass Melting Icon SVG -->
            <svg class="w-6 h-6 text-orange-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M8 3h8l1 6a5 5 0 0 1-5 5 5 5 0 0 1-5-5l1-6Z" />
              <path d="M12 14v7" />
              <path d="M8 21h8" />
              <path d="M7.5 8h9" class="text-cyan-400" stroke="currentColor" />
            </svg>
          </div>
        </div>
        <div>
          <div class="flex items-center gap-2">
            <h1 class="text-base sm:text-lg font-bold tracking-tight text-white">
              GLASS-LINE 04 <span class="text-orange-400 font-mono text-sm">DIGITAL TWIN</span>
            </h1>
            <span id="systemStatusBadge" class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
              <span id="systemStatusDot" class="w-2 h-2 rounded-full bg-emerald-400 led-blink"></span>
              <span id="systemStatusText">NORMAL OPERATION</span>
            </span>
          </div>
          <p class="text-xs text-slate-400 hidden sm:block">
            ระบบจำลองสายการผลิตแก้วอุตสาหกรรม (Soda-Lime Glass Process Engineering SCADA)
          </p>
        </div>
      </div>

      <!-- Playback, Speed & Guided Tour Controls -->
      <div class="flex flex-wrap items-center gap-2">
        <!-- Guided Tour Toggle -->
        <button id="btnGuidedTour" onclick="toggleGuidedTour()" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs sm:text-sm font-medium bg-cyan-500/15 hover:bg-cyan-500/25 text-cyan-300 border border-cyan-500/40 transition active:scale-95">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span id="btnGuidedTourLabel">แนะนำทีละขั้นตอน (Tour)</span>
        </button>

        <!-- Play / Pause Button -->
        <button id="btnPlayPause" onclick="togglePlayPause()" class="flex items-center gap-1.5 px-3 py-2 rounded-lg text-xs sm:text-sm font-semibold bg-orange-600 hover:bg-orange-500 text-white shadow-md shadow-orange-600/20 transition active:scale-95">
          <svg id="iconPause" class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zM7 8a1 1 0 012 0v4a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v4a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
          </svg>
          <svg id="iconPlay" class="w-4 h-4 hidden" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd" />
          </svg>
          <span id="playPauseLabel">หยุดชั่วคราว</span>
        </button>

        <!-- Simulation Speed Toggle (1x / 2x) -->
        <div class="inline-flex rounded-lg bg-slate-900 p-1 border border-slate-800">
          <button id="speed1x" onclick="setSimSpeed(1)" class="px-2.5 py-1 rounded-md text-xs font-mono font-bold bg-slate-700 text-white transition">1x</button>
          <button id="speed2x" onclick="setSimSpeed(2)" class="px-2.5 py-1 rounded-md text-xs font-mono font-bold text-slate-400 hover:text-white transition">2x</button>
        </div>

        <!-- Reset All Button -->
        <button onclick="resetSimulation()" title="รีเซ็ตค่าทั้งหมดกลับสู่มาตรฐาน" class="p-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-300 border border-slate-700 transition active:scale-95">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
        </button>
      </div>
    </div>
  </header>

  <!-- =====================================================================
       ALARM / NOTIFICATION BANNER (Dynamic Toast Area)
       ===================================================================== -->
  <div id="alarmBanner" class="hidden bg-red-950/90 border-b border-red-500/50 px-4 py-2 text-xs sm:text-sm text-red-200">
    <div class="max-w-[1600px] mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="px-2 py-0.5 rounded bg-red-600 text-white font-mono font-bold text-xs animate-pulse">ALARM</span>
        <span id="alarmMessage" class="font-medium">ตรวจพบความผิดปกติในสายการผลิต</span>
      </div>
      <button onclick="clearFaults()" class="px-3 py-1 rounded bg-red-600/40 hover:bg-red-600/60 border border-red-400/50 text-white text-xs font-semibold transition">
        แก้ไขและรีเซ็ตระบบสาธารณูปโภค
      </button>
    </div>
  </div>

  <!-- =====================================================================
       MAIN DASHBOARD CONTAINER
       ===================================================================== -->
  <main class="flex-1 max-w-[1600px] w-full mx-auto px-3 sm:px-6 py-4 space-y-4">

    <!-- 1. LIVE KPI TELEMETRY STRIP -->
    <section aria-label="Live KPI Telemetry" class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-6 gap-3">
      <!-- KPI 1: Pack-to-Melt Efficiency -->
      <div class="bg-[#0e1525] border border-slate-800/90 rounded-xl p-3 flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-xs text-slate-400">
          <span>Pack-to-Melt Eff.</span>
          <span class="font-mono text-[11px] text-emerald-400">TARGET ≥92%</span>
        </div>
        <div class="mt-1.5 flex items-baseline justify-between">
          <span id="kpiEfficiency" class="text-2xl font-mono font-bold text-emerald-400">94.2%</span>
          <span id="kpiEffTrend" class="text-xs font-mono text-emerald-400/80">OPTIMAL</span>
        </div>
        <div class="w-full bg-slate-800 h-1.5 rounded-full mt-2 overflow-hidden">
          <div id="barEfficiency" class="bg-emerald-500 h-full rounded-full transition-all duration-300" style="width: 94.2%"></div>
        </div>
      </div>

      <!-- KPI 2: Good vs Reject Output -->
      <div class="bg-[#0e1525] border border-slate-800/90 rounded-xl p-3 flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-xs text-slate-400">
          <span>ของดี / ของเสีย (pcs/min)</span>
          <span class="font-mono text-[11px] text-cyan-400">LIVE</span>
        </div>
        <div class="mt-1.5 flex items-baseline gap-2">
          <span id="kpiGoodRate" class="text-xl font-mono font-bold text-white">42.4</span>
          <span class="text-slate-500 text-xs">/</span>
          <span id="kpiRejectRate" class="text-base font-mono font-bold text-rose-400">2.6</span>
          <span class="text-[11px] text-slate-400 ml-auto">pcs/m</span>
        </div>
        <div class="flex gap-1 h-1.5 mt-2 rounded-full overflow-hidden bg-slate-800">
          <div id="barGoodRatio" class="bg-cyan-400 h-full transition-all duration-300" style="width: 94%"></div>
          <div id="barRejectRatio" class="bg-rose-500 h-full transition-all duration-300" style="width: 6%"></div>
        </div>
      </div>

      <!-- KPI 3: Glass Viscosity -->
      <div class="bg-[#0e1525] border border-slate-800/90 rounded-xl p-3 flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-xs text-slate-400">
          <span>ความหนืดน้ำแก้ว (Viscosity)</span>
          <span class="font-mono text-[11px] text-orange-400">GOB FEED</span>
        </div>
        <div class="mt-1.5 flex items-baseline justify-between">
          <span id="kpiViscosity" class="text-2xl font-mono font-bold text-orange-400">3.12</span>
          <span class="text-xs font-mono text-slate-400">log₁₀ η (Poise)</span>
        </div>
        <div class="text-[11px] text-slate-400 mt-1.5 truncate" id="kpiViscosityNote">
          ความหนืดเหมาะสมต่อการตัด Gob
        </div>
      </div>

      <!-- KPI 4: Residual Thermal Stress -->
      <div class="bg-[#0e1525] border border-slate-800/90 rounded-xl p-3 flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-xs text-slate-400">
          <span>ความเค้นสะสม (Stress)</span>
          <span class="font-mono text-[11px] text-cyan-400">&lt;50 nm/cm</span>
        </div>
        <div class="mt-1.5 flex items-baseline justify-between">
          <span id="kpiStress" class="text-2xl font-mono font-bold text-cyan-400">24</span>
          <span class="text-xs font-mono text-slate-400">nm/cm</span>
        </div>
        <div class="text-[11px] text-slate-400 mt-1.5 truncate" id="kpiStressNote">
          โครงสร้างโมเลกุลคลายตัวสมบูรณ์
        </div>
      </div>

      <!-- KPI 5: Specific Energy Consumption -->
      <div class="bg-[#0e1525] border border-slate-800/90 rounded-xl p-3 flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-xs text-slate-400">
          <span>พลังงานจำเพาะ (Energy)</span>
          <span id="kpiCo2Save" class="font-mono text-[11px] text-emerald-400">-7.5% CO₂</span>
        </div>
        <div class="mt-1.5 flex items-baseline justify-between">
          <span id="kpiEnergy" class="text-2xl font-mono font-bold text-amber-400">4.35</span>
          <span class="text-xs font-mono text-slate-400">GJ / ton</span>
        </div>
        <div class="text-[11px] text-slate-400 mt-1.5 truncate" id="kpiEnergyNote">
          Cullet 25% ช่วยลดเชื้อเพลิงเตาหลอม
        </div>
      </div>

      <!-- KPI 6: Utilities Status -->
      <div class="bg-[#0e1525] border border-slate-800/90 rounded-xl p-3 flex flex-col justify-between shadow-sm">
        <div class="flex items-center justify-between text-xs text-slate-400">
          <span>สาธารณูปโภค (Utilities)</span>
          <span id="kpiUtilStatus" class="font-mono text-[11px] text-emerald-400">NOMINAL</span>
        </div>
        <div class="mt-1.5 space-y-1 text-[11px] font-mono">
          <div class="flex items-center justify-between">
            <span class="text-slate-400">GAS:</span>
            <span id="utilGasVal" class="text-amber-300">2.4 bar (OK)</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-400">COOL AIR:</span>
            <span id="utilCoolAirVal" class="text-cyan-300">100% (OK)</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-slate-400">COMP AIR:</span>
            <span id="utilCompAirVal" class="text-emerald-300">6.5 bar</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 2. INTERACTIVE PROCESS FLOW VIEWPORT (CANVAS + STATION BAR) -->
    <section class="bg-[#0e1525] border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
      <!-- Viewport Toolbar -->
      <div class="px-4 py-2.5 bg-[#0b1120] border-b border-slate-800 flex flex-wrap items-center justify-between gap-2">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-orange-500"></span>
          <h2 class="text-xs sm:text-sm font-semibold text-slate-200">
            แผนผังสายการผลิตแบบเรียลไทม์ (Interactive Process Flow & Cullet Loop)
          </h2>
          <span class="hidden md:inline-block text-xs text-slate-500">— คลิกที่สถานีใดก็ได้เพื่อดูหลักการทำงานและจุดบำรุงรักษา</span>
        </div>

        <!-- Quick Forming Machine Mode Switcher -->
        <div class="flex items-center gap-1.5 text-xs">
          <span class="text-slate-400 hidden sm:inline">เครื่องขึ้นรูป:</span>
          <div class="inline-flex rounded-lg bg-slate-900 p-0.5 border border-slate-700/80">
            <button onclick="setFormingMode('h28')" id="modeBtn-h28" class="px-2.5 py-1 rounded-md font-medium bg-orange-600 text-white transition">
              H-28 Paste Mold
            </button>
            <button onclick="setFormingMode('press')" id="modeBtn-press" class="px-2.5 py-1 rounded-md font-medium text-slate-400 hover:text-white transition">
              Rotary Press
            </button>
            <button onclick="setFormingMode('is')" id="modeBtn-is" class="px-2.5 py-1 rounded-md font-medium text-slate-400 hover:text-white transition">
              IS Machine
            </button>
          </div>
        </div>
      </div>

      <!-- Guided Tour Banner (Shown when Guided Tour is active) -->
      <div id="guidedTourBar" class="hidden bg-gradient-to-r from-cyan-950/90 via-slate-900 to-cyan-950/90 border-b border-cyan-500/40 px-4 py-2.5">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <div class="flex items-center gap-3">
            <span id="tourStepBadge" class="px-2.5 py-1 rounded-md bg-cyan-500 text-slate-950 font-mono font-bold text-xs">
              STEP 1 / 7
            </span>
            <div>
              <h3 id="tourStepTitle" class="text-sm font-bold text-cyan-200">สถานีที่ 1: Batch House</h3>
              <p id="tourStepDesc" class="text-xs text-slate-300">ชั่งตวงและผสมวัตถุดิบหลักให้เป็นเนื้อเดียวกันก่อนป้อนเข้าเตาหลอม</p>
            </div>
          </div>
          <div class="flex items-center gap-2">
            <button onclick="prevTourStep()" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-medium border border-slate-600 transition">
              ← ก่อนหน้า
            </button>
            <button onclick="nextTourStep()" class="px-3 py-1.5 rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-semibold transition">
              ถัดไป →
            </button>
            <button onclick="toggleGuidedTour()" class="px-2.5 py-1.5 rounded-lg bg-slate-900 hover:bg-slate-800 text-slate-400 text-xs border border-slate-700">
              ปิดทัวร์
            </button>
          </div>
        </div>
      </div>

      <!-- Scrollable/Responsive Canvas Container -->
      <div id="canvasScrollWrapper" class="relative w-full overflow-x-auto scada-grid-bg select-none">
        <div class="min-w-[1050px] w-full h-[430px] sm:h-[470px] relative">
          <canvas id="processCanvas" class="w-full h-full block cursor-pointer"></canvas>
        </div>
      </div>

      <!-- Station Selector Pills (Easy Touch/Mobile Navigation) -->
      <div class="px-3 py-2.5 bg-[#0b1120] border-t border-slate-800 flex items-center gap-1.5 overflow-x-auto">
        <span class="text-[11px] font-mono text-slate-500 uppercase mr-1 shrink-0">STATIONS:</span>
        <button onclick="selectStation(0)" id="pill-0" class="station-pill shrink-0 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
          1. Batch House
        </button>
        <button onclick="selectStation(1)" id="pill-1" class="station-pill shrink-0 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
          2. Melting Furnace
        </button>
        <button onclick="selectStation(2)" id="pill-2" class="station-pill shrink-0 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
          3. Gob Feeder
        </button>
        <button onclick="selectStation(3)" id="pill-3" class="station-pill shrink-0 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
          4. Forming Machine
        </button>
        <button onclick="selectStation(4)" id="pill-4" class="station-pill shrink-0 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
          5. Annealing Lehr
        </button>
        <button onclick="selectStation(5)" id="pill-5" class="station-pill shrink-0 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
          6. Surface Coating
        </button>
        <button onclick="selectStation(6)" id="pill-6" class="station-pill shrink-0 px-2.5 py-1.5 rounded-lg text-xs font-medium bg-slate-800/90 hover:bg-slate-700 text-slate-200 border border-slate-700 transition">
          7. Cold-End QC & Cullet
        </button>
      </div>
    </section>

    <!-- 3. BOTTOM WORKSPACE: ENGINEERING CONTROLS (LEFT) + LIVE ANALYTICS & INSPECTOR (RIGHT) -->
    <section class="grid grid-cols-1 lg:grid-cols-12 gap-4">

      <!-- LEFT COLUMN (5 cols): Interactive Process Control Panel & Utility Faults -->
      <div class="lg:col-span-5 space-y-4">
        <!-- Engineering Parameters Card -->
        <div class="bg-[#0e1525] border border-slate-800 rounded-2xl p-4 shadow-lg">
          <div class="flex items-center justify-between mb-3 pb-2 border-b border-slate-800">
            <div class="flex items-center gap-2">
              <svg class="w-4 h-4 text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
              <h3 class="text-sm font-bold text-white">แผงควบคุมพารามิเตอร์ทางวิศวกรรม</h3>
            </div>
            <span class="text-[11px] font-mono text-slate-400">PROCESS CONTROL</span>
          </div>

