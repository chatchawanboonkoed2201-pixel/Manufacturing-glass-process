    /**
     * Handle Responsive HiDPI Canvas Resizing
     */
    function handleResize() {
      // 1. Main Process Canvas
      const rect = processCanvas.parentElement.getBoundingClientRect();
      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      processCanvas.width = rect.width * dpr;
      processCanvas.height = rect.height * dpr;

      // 2. Annealing Chart Canvas
      const aRect = annealingCanvas.parentElement.getBoundingClientRect();
      annealingCanvas.width = aRect.width * dpr;
      annealingCanvas.height = aRect.height * dpr;

      // 3. Polariscope Canvas
      const pRect = polariscopeCanvas.parentElement.getBoundingClientRect();
      polariscopeCanvas.width = pRect.width * dpr;
      polariscopeCanvas.height = pRect.height * dpr;
    }

