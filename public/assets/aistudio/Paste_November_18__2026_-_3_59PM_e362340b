    function updateControls() {
      simState.furnaceTemp = parseInt(document.getElementById('sliderTemp').value, 10);
      simState.culletRatio = parseInt(document.getElementById('sliderCullet').value, 10);
      simState.gobSpeed = parseInt(document.getElementById('sliderGobSpeed').value, 10);

      document.getElementById('valFurnaceTemp').textContent = `${simState.furnaceTemp.toLocaleString()} °C`;
      document.getElementById('valCulletRatio').textContent = `${simState.culletRatio} %`;
      document.getElementById('valGobSpeed').textContent = `${simState.gobSpeed} cuts/min`;

      recalculateEngineeringMetrics();
    }

    function recalculateEngineeringMetrics() {
      // Burner Gas Fluctuation adds oscillatory instability
      const gasFluctuation = simState.faults.gasPressure
        ? Math.sin(simState.time * 4.5) * 42 - 25
        : 0;

      const effectiveTemp = simState.furnaceTemp + gasFluctuation;
      simState.effectiveTemp = effectiveTemp;

      // 1. Glass Viscosity at Gob Feeder (Arrhenius-like inverse relation to temp)
      // Optimal around 1520°C -> ~3.12 log10 Poise
      const visc = 3.12 - (effectiveTemp - 1520) * 0.0042;
      simState.viscosityLogPoise = Math.max(2.5, Math.min(3.9, visc));

      // 2. Ideal Melting Temperature shifts slightly lower with higher Cullet Ratio
      const idealTemp = 1520 - (simState.culletRatio * 0.6);

      // 3. Seed/Blister Defect Probability
      // High if effectiveTemp is too low relative to idealTemp, or gas is fluctuating
      let blisterProb = 0.012;
      if (effectiveTemp < idealTemp - 15) {
        blisterProb += Math.pow((idealTemp - 15 - effectiveTemp) / 45, 1.7) * 0.24;
      }
      if (simState.faults.gasPressure) {
        blisterProb += 0.085;
      }

      // 4. Forming Deformation Probability
      // High if Gob Speed > 58 (insufficient mold cooling time), Cooling Air fault, or glass too runny (>1575°C)
      let deformProb = 0.014;
      if (simState.gobSpeed > 55) {
        deformProb += Math.pow((simState.gobSpeed - 55) / 25, 1.5) * 0.18;
      }
      if (effectiveTemp > 1570) {
        deformProb += ((effectiveTemp - 1570) / 30) * 0.12;
      }
      if (simState.faults.coolingAir) {
        deformProb += 0.22;
      }

      // 5. Residual Thermal Stress & Crack Probability (Driven by Annealing Cooling Rate)
      let baseStress = 24;
      let stressCrackProb = 0.012;
      if (simState.annealingRate === 'slow') {
        baseStress = 12;
        stressCrackProb = 0.005;
      } else if (simState.annealingRate === 'standard') {
        baseStress = 24;
        stressCrackProb = 0.014;
      } else if (simState.annealingRate === 'fast') {
        baseStress = 132;
        stressCrackProb = 0.21;
      }
      // Thermal shock delta from high furnace temp
      if (effectiveTemp > 1565) {
        baseStress += (effectiveTemp - 1565) * 0.45;
      }
      simState.thermalStressNm = Math.round(baseStress);

      simState.defectBreakdown = {
        blister: Math.min(0.45, blisterProb),
        deformed: Math.min(0.45, deformProb),
        stressCrack: Math.min(0.45, stressCrackProb)
      };

      const totalRejectProb = Math.min(
        0.72,
        simState.defectBreakdown.blister +
        simState.defectBreakdown.deformed +
        simState.defectBreakdown.stressCrack
      );

      simState.efficiencyPct = Math.max(25, (1 - totalRejectProb) * 100);
      simState.goodRatePcs = (simState.gobSpeed * (simState.efficiencyPct / 100));
      simState.rejectRatePcs = simState.gobSpeed - simState.goodRatePcs;

      // 6. Specific Energy Consumption (GJ/ton)
      // Base 4.65 GJ/ton at 0% cullet, 1520°C. Every 10% cullet saves ~2.6% energy.
      const culletSavingsFactor = 1 - (simState.culletRatio * 0.0026);
      const tempPenalty = 1 + ((simState.furnaceTemp - 1520) * 0.0014);
      const annealFactor = simState.annealingRate === 'slow' ? 1.03 : (simState.annealingRate === 'fast' ? 0.98 : 1.0);
      simState.specificEnergyGJ = 4.65 * culletSavingsFactor * tempPenalty * annealFactor;

      updateTelemetryUI();
    }

