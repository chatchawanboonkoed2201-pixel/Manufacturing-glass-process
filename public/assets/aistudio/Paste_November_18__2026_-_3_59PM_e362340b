    /**
     * Draw Moving Glassware Products on Conveyor (with Thermal Color Transition & Defect Markers)
     */
    function drawWareItems() {
      ctx.save();
      simState.wareItems.forEach(item => {
        const x = item.x;
        const y = item.y + item.rejectY;

        // Thermal Color Transition across Lehr (x = 785 -> 1005)
        let fillCol = '#38bdf8';
        let strokeCol = '#bae6fd';
        if (x < 785) {
          fillCol = 'rgba(251, 146, 60, 0.85)';
          strokeCol = '#fed7aa';
        } else if (x < 1005) {
          const t = (x - 785) / 220;
          if (t < 0.45) {
            fillCol = 'rgba(249, 115, 22, 0.7)';
            strokeCol = '#fdba74';
          } else {
            fillCol = 'rgba(56, 189, 248, 0.55)';
            strokeCol = '#bae6fd';
          }
        } else {
          fillCol = item.rejected ? 'rgba(244, 63, 94, 0.75)' : 'rgba(56, 189, 248, 0.45)';
          strokeCol = item.rejected ? '#fda4af' : '#e0f2fe';
        }

        ctx.fillStyle = fillCol;
        ctx.strokeStyle = strokeCol;
        ctx.lineWidth = 1.5;

        // Draw distinct silhouette based on Forming Mode & Deform status
        ctx.beginPath();
        if (item.defect === 'DEFORMED') {
          // Warped tilted glass silhouette
          ctx.moveTo(x - 7, y);
          ctx.lineTo(x - 3, y - 22);
          ctx.lineTo(x + 10, y - 20);
          ctx.lineTo(x + 6, y);
          ctx.closePath();
        } else if (item.shape === 'h28') {
          // Tall thin tumbler / stemless wine glass
          ctx.moveTo(x - 6, y);
          ctx.lineTo(x - 7, y - 24);
          ctx.lineTo(x + 7, y - 24);
          ctx.lineTo(x + 6, y);
          ctx.closePath();
        } else if (item.shape === 'press') {
          // Wide heavy-base bowl / tumbler
          ctx.moveTo(x - 8, y);
          ctx.lineTo(x - 10, y - 16);
          ctx.lineTo(x + 10, y - 16);
          ctx.lineTo(x + 8, y);
          ctx.closePath();
        } else {
          // Bottle silhouette (IS Machine)
          ctx.moveTo(x - 6, y);
          ctx.lineTo(x - 6, y - 15);
          ctx.lineTo(x - 3, y - 20);
          ctx.lineTo(x - 3, y - 27);
          ctx.lineTo(x + 3, y - 27);
          ctx.lineTo(x + 3, y - 20);
          ctx.lineTo(x + 6, y - 15);
          ctx.lineTo(x + 6, y);
          ctx.closePath();
        }
        ctx.fill();
        ctx.stroke();

        // Draw Defect Visual Indicator (Blister dot or Stress Crack line)
        if (item.defect === 'BLISTER') {
          ctx.fillStyle = '#fef08a';
          ctx.beginPath();
          ctx.arc(x, y - 11, 2.2, 0, Math.PI * 2);
          ctx.fill();
        } else if (item.defect === 'CRACK') {
          ctx.strokeStyle = '#f43f5e';
          ctx.lineWidth = 1.5;
          ctx.beginPath();
          ctx.moveTo(x - 3, y - 16);
          ctx.lineTo(x + 2, y - 10);
          ctx.lineTo(x - 2, y - 4);
          ctx.stroke();
        }

        // Reject Tag Badge when kicked out at QC
        if (item.rejected) {
          ctx.fillStyle = '#e11d48';
          ctx.font = 'bold 8px "JetBrains Mono", sans-serif';
          ctx.textAlign = 'center';
          ctx.fillText(item.defect, x, y - 30);
        }
      });
      ctx.restore();
    }

