        });
      }

      // Seed initial ware items along the conveyor so line looks alive immediately
      const seedPositions = [690, 750, 820, 890, 960, 1045, 1120, 1205];
      seedPositions.forEach((px) => {
        simState.wareItems.push(createWareItem(px));
      });

      // Seed initial cullet particles in return loop
      for (let i = 0; i < 14; i++) {
        simState.culletParticles.push({
          progress: i / 14, // 0 (at crusher) -> 1 (at Batch House cullet silo)
          size: 3 + Math.random() * 2.5,
