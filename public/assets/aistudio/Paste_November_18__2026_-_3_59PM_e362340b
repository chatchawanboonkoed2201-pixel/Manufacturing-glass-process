    /**
     * =========================================================================
     * 7. SECONDARY DIAGNOSTIC CHARTS (ANNEALING CURVE & POLARISCOPE VIEW)
     * =========================================================================
     */
    function renderAnnealingChart() {
      const w = annealingCanvas.width;
      const h = annealingCanvas.height;
      actx.save();
      actx.clearRect(0, 0, w, h);

      const padL = 44 * (w / 420);
      const padR = 16 * (w / 420);
      const padT = 18 * (h / 175);
      const padB = 26 * (h / 175);
      const plotW = w - padL - padR;
      const plotH = h - padT - padB;

      // Grid & Critical Threshold Lines (Annealing Point 550°C, Strain Point 500°C)
      const tempToY = (t) => padT + plotH * (1 - (t - 0) / 650);

      // Annealing & Strain Band
      const y550 = tempToY(550);
      const y500 = tempToY(500);
      actx.fillStyle = 'rgba(249, 115, 22, 0.12)';
      actx.fillRect(padL, y550, plotW, y500 - y550);

      actx.strokeStyle = 'rgba(249, 115, 22, 0.5)';
      actx.setLineDash([4, 4]);
      actx.lineWidth = 1;
      actx.beginPath();
      actx.moveTo(padL, y550);
      actx.lineTo(padL + plotW, y550);
      actx.stroke();

      actx.strokeStyle = 'rgba(6, 182, 212, 0.5)';
      actx.beginPath();
      actx.moveTo(padL, y500);
      actx.lineTo(padL + plotW, y500);
      actx.stroke();
      actx.setLineDash([]);

      // Y-Axis Labels
      actx.fillStyle = '#94a3b8';
      actx.font = `${Math.max(10, Math.round(10 * (w / 420)))}px "JetBrains Mono", sans-serif`;
      actx.textAlign = 'right';
      actx.fillText('550°C', padL - 6, y550 + 3);
      actx.fillText('500°C', padL - 6, y500 + 3);
      actx.fillText('65°C', padL - 6, tempToY(65) + 3);

      // Ideal Reference Curve (Dashed Gray)
      actx.strokeStyle = 'rgba(148, 163, 184, 0.45)';
      actx.lineWidth = 2;
      actx.setLineDash([5, 5]);
      actx.beginPath();
      actx.moveTo(padL, tempToY(580));
      actx.lineTo(padL + plotW * 0.25, tempToY(550)); // Equalize
      actx.lineTo(padL + plotW * 0.55, tempToY(500)); // Slow cool through strain point
      actx.lineTo(padL + plotW, tempToY(65));         // Controlled fast cool to exit
      actx.stroke();
      actx.setLineDash([]);

      // Active Live Curve based on selected Annealing Rate
      const curveGrad = actx.createLinearGradient(padL, 0, padL + plotW, 0);
      curveGrad.addColorStop(0, '#f97316');
      curveGrad.addColorStop(0.5, '#fbbf24');
      curveGrad.addColorStop(1, '#06b6d4');

      actx.strokeStyle = simState.annealingRate === 'fast' ? '#f43f5e' : curveGrad;
      actx.lineWidth = 3;
      actx.beginPath();
      actx.moveTo(padL, tempToY(580));

      if (simState.annealingRate === 'standard') {
        actx.lineTo(padL + plotW * 0.25, tempToY(550));
        actx.lineTo(padL + plotW * 0.55, tempToY(500));
        actx.lineTo(padL + plotW, tempToY(65));
      } else if (simState.annealingRate === 'slow') {
        actx.lineTo(padL + plotW * 0.35, tempToY(552));
        actx.lineTo(padL + plotW * 0.72, tempToY(498));
        actx.lineTo(padL + plotW, tempToY(85));
      } else {
        // Fast cooling drops sharply through 550->500°C causing severe thermal gradient!
        actx.lineTo(padL + plotW * 0.12, tempToY(530));
        actx.lineTo(padL + plotW * 0.28, tempToY(240));
        actx.lineTo(padL + plotW, tempToY(55));
      }
      actx.stroke();

      // Zone X-Axis Labels
      actx.fillStyle = '#64748b';
      actx.textAlign = 'center';
      actx.fillText('Zone 1 (Heat)', padL + plotW * 0.18, h - 6);
      actx.fillText('Zone 2 (Anneal)', padL + plotW * 0.5, h - 6);
      actx.fillText('Zone 3 (Cool)', padL + plotW * 0.84, h - 6);

      actx.restore();
    }

    /**
     * Render Photoelastic Polariscope Stress View (Shows rainbow interference fringes when stress is high)
     */
    function renderPolariscopeView() {
      const w = polariscopeCanvas.width;
      const h = polariscopeCanvas.height;
      pctx.save();
      pctx.clearRect(0, 0, w, h);

      const cx = w / 2;
      const cy = h / 2;
      const scale = Math.min(w, h) / 180;

      // Polarized dark-purple background field
      pctx.fillStyle = '#090d1a';
      pctx.fillRect(0, 0, w, h);

      // Crosshair Reticle
      pctx.strokeStyle = 'rgba(148, 163, 184, 0.2)';
      pctx.lineWidth = 1;
      pctx.beginPath();
      pctx.moveTo(cx, 12);
      pctx.lineTo(cx, h - 12);
      pctx.moveTo(12, cy);
      pctx.lineTo(w - 12, cy);
      pctx.stroke();

      // Glass Cross-Section Silhouette under Polarized Light
      pctx.save();
      pctx.translate(cx, cy);
      pctx.scale(scale, scale);

      // Glass outer wall
      pctx.beginPath();
      pctx.moveTo(-36, -52);
      pctx.lineTo(-30, 48);
      pctx.lineTo(30, 48);
      pctx.lineTo(36, -52);
      pctx.closePath();

      if (simState.thermalStressNm > 50) {
        // High Stress: Vivid Photoelastic Birefringence Bands (Magenta / Yellow / Cyan)
        const stressGrad = pctx.createLinearGradient(-36, -50, 36, 48);
        stressGrad.addColorStop(0, 'rgba(236, 72, 153, 0.85)');
        stressGrad.addColorStop(0.25, 'rgba(250, 204, 21, 0.85)');
        stressGrad.addColorStop(0.5, 'rgba(6, 182, 212, 0.85)');
        stressGrad.addColorStop(0.75, 'rgba(244, 63, 94, 0.85)');
        stressGrad.addColorStop(1, 'rgba(168, 85, 247, 0.85)');
        pctx.fillStyle = stressGrad;
        pctx.fill();

        // Stress Isochromatic Fringes along base & rim
        pctx.strokeStyle = '#fde047';
        pctx.lineWidth = 3;
        pctx.strokeRect(-26, 32, 52, 12);
      } else {
        // Low Stress: Uniform neutral blue-violet polarized tint
        const calmGrad = pctx.createLinearGradient(0, -50, 0, 48);
        calmGrad.addColorStop(0, 'rgba(56, 189, 248, 0.25)');
        calmGrad.addColorStop(1, 'rgba(99, 102, 241, 0.35)');
        pctx.fillStyle = calmGrad;
        pctx.fill();
      }

      pctx.strokeStyle = '#94a3b8';
      pctx.lineWidth = 2;
      pctx.stroke();
      pctx.restore();

      // Overlay Telemetry Readout
      pctx.fillStyle = simState.thermalStressNm > 50 ? '#fda4af' : '#67e8f9';
      pctx.font = `bold ${Math.max(10, Math.round(11 * scale))}px "JetBrains Mono", sans-serif`;
      pctx.textAlign = 'left';
      pctx.fillText(`RETARDATION: ${simState.thermalStressNm} nm/cm`, 10, h - 10);

      pctx.restore();
    }

    /**
     * Utility: Rounded Rectangle Path Helper
     */
    function roundRect(context, x, y, w, h, r) {
      context.beginPath();
      context.moveTo(x + r, y);
      context.arcTo(x + w, y, x + w, y + h, r);
      context.arcTo(x + w, y + h, x, y + h, r);
      context.arcTo(x, y + h, x, y, r);
      context.arcTo(x, y, x + w, y, r);
      context.closePath();
    }

    /**
     * =========================================================================
     * 8. MAIN REQUESTANIMATIONFRAME LOOP
     * =========================================================================
     */
    function animationLoop(timestamp) {
      if (!simState.lastTimestamp) simState.lastTimestamp = timestamp;
      const dt = Math.min(0.05, (timestamp - simState.lastTimestamp) / 1000);
      simState.lastTimestamp = timestamp;

      if (simState.isPlaying) {
        updateEntities(dt);
      }

      renderProcessCanvas();
      renderAnnealingChart();
      renderPolariscopeView();

      requestAnimationFrame(animationLoop);
    }

    // Boot Simulator on Window Load
    window.addEventListener('load', initSimulation);
  </script>
</body>
